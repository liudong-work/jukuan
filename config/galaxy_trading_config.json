{
  "broker_info": {
    "name": "银河证券",
    "server_url": "https://trade.galaxy.com.cn",
    "api_version": "v1.0",
    "description": "银河证券实盘交易配置"
  },
  "account_settings": {
    "account": "",
    "password": "",
